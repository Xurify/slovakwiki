{
  "name": "slovakwiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "check": "astro check && svelte-check --threshold error",
    "lint": "prettier --check . && eslint src/lib scripts",
    "typecheck": "astro check && svelte-check --threshold error",
    "preview": "astro preview --host 0.0.0.0",
    "test": "vitest run",
    "index:search": "bun scripts/search/build-search-index.ts",
    "frequency:static": "bun scripts/frequency/publish-static.ts",
    "cwv:check": "bun scripts/cwv/check-dictionary-size.ts",
    "audio:check": "bun scripts/audio/check-build.ts",
    "fouc:boot": "bun scripts/fouc/generate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vercel": "^11.0.11",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.10.0",
    "astro": "^7.3.5",
    "aws4fetch": "^1.0.20",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "seek-bzip": "^2.0.0",
    "svelte": "^5.55.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "{src/lib,scripts}/**/*.{cjs,js,mjs,svelte,ts}": "eslint --no-warn-ignored"
  }
}
