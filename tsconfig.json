{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["src/*"],
      "$lib/*": ["src/lib/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "static/pagefind",
    "tmp",
    "content/audio/manifest.json",
    "content/audio/runtime-index.json"
  ]
}
