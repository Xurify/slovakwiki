---
import Footer from "$lib/components/Footer.svelte";
import Header from "$lib/components/Header.svelte";
import Sidebar from "$lib/components/Sidebar.svelte";
import "../styles.css";

interface Props {
  description?: string;
  title: string;
}

const { description, title } = Astro.props;
const pathname = Astro.url.pathname;
const query = Astro.url.searchParams.get("q") ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <div class="grid min-h-screen grid-cols-[var(--sidebar-width)_minmax(0,1fr)] max-[800px]:block">
      <Sidebar {pathname} />
      <div class="flex min-h-screen min-w-0 flex-col bg-(--surface)">
        <Header {pathname} {query} />
        <div id="main-content" class="min-h-0 flex-1" tabindex="-1">
          <slot />
        </div>
        <Footer />
      </div>
    </div>
  </body>
</html>
