---
import Footer from "$lib/chrome/Footer.svelte";
import Header from "$lib/chrome/Header.svelte";
import HeaderSearch from "$lib/search/HeaderSearch.svelte";
import { absoluteSiteUrl, SITE_NAME } from "$lib/seo/site";
import plexLatin from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import plexLatinExt from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-ext-wght-normal.woff2?url";
import serifLatin from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import serifLatinExt from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-ext-wght-normal.woff2?url";
import handLatin from "@fontsource-variable/caveat/files/caveat-latin-wght-normal.woff2?url";
import handLatinExt from "@fontsource-variable/caveat/files/caveat-latin-ext-wght-normal.woff2?url";
import "../styles.css";

interface Props {
  /** Path-only canonical (no query, no hash). Defaults to current pathname. */
  canonicalPath?: string;
  description?: string;
  /** When true, adds `noindex, follow` (filter/search/session URLs). */
  noindex?: boolean;
  /**
   * The page draws the stick-figure stage, whose boards and stalls are
   * lettered in Caveat. Loaded only once a scene shows, the font swapped in
   * under the lettering as the scene came into view; preloading keeps it still.
   */
  stage?: boolean;
  title: string;
}

const { canonicalPath, description, noindex = false, stage = false, title } = Astro.props;
const pathname = Astro.url.pathname;
const query = Astro.url.searchParams.get("q") ?? "";
const resolvedCanonicalPath = canonicalPath ?? pathname;
const canonicalUrl = absoluteSiteUrl(resolvedCanonicalPath);
const ogImage = absoluteSiteUrl("/icon-512.png");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <link rel="preload" href={plexLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatinExt} as="font" type="font/woff2" crossorigin />
    {
      stage && (
        <>
          <link rel="preload" href={handLatin} as="font" type="font/woff2" crossorigin />
          <link
            rel="preload"
            href={handLatinExt}
            as="font"
            type="font/woff2"
            crossorigin
          />
        </>
      )
    }
    <script is:inline>
      (function () {
        var storageKey = "slovak.wiki.theme-preference";
        var preference = "system";
        try {
          var stored = localStorage.getItem(storageKey);
          if (stored === "light" || stored === "dark" || stored === "system") {
            preference = stored;
          }
        } catch (e) {}
        var sfx = "on";
        try {
          var storedSfx = localStorage.getItem("slovak.wiki.sfx-preference");
          if (storedSfx === "on" || storedSfx === "off") {
            sfx = storedSfx;
          }
        } catch (e) {}
        var storyEn = "off";
        try {
          var storedEn = localStorage.getItem("slovak.wiki.story-show-english");
          if (storedEn === "on" || storedEn === "off") {
            storyEn = storedEn;
          }
        } catch (e) {}
        var storySubtitles = "on";
        try {
          var storedSubtitles = localStorage.getItem("slovak.wiki.story-subtitles");
          if (storedSubtitles === "on" || storedSubtitles === "off") {
            storySubtitles = storedSubtitles;
          }
        } catch (e) {}
        var listenVoices = "on";
        try {
          var storedVoices = localStorage.getItem("slovak.wiki.listen-show-voices");
          if (storedVoices === "on" || storedVoices === "off") {
            listenVoices = storedVoices;
          }
        } catch (e) {}
        var dark =
          preference === "dark" ||
          (preference === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        var theme = dark ? "dark" : "light";
        var root = document.documentElement;
        root.dataset.theme = theme;
        root.dataset.themePreference = preference;
        root.dataset.sfxPreference = sfx;
        root.dataset.storyShowEnglish = storyEn;
        root.dataset.storySubtitles = storySubtitles;
        root.dataset.listenVoices = listenVoices;
        root.classList.add("js");
        root.style.colorScheme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute("content", theme === "dark" ? "#0f172a" : "#ffffff");
        }
      })();
    </script>
  </head>
  <body>
    <div class="relative z-[1] flex min-h-screen min-w-0 flex-col">
      <Header client:load {pathname}>
        <HeaderSearch client:idle slot="search" {pathname} {query} />
      </Header>
      <div id="main-content" class="min-h-0 flex-1" tabindex="-1">
        <slot />
      </div>
      <Footer pathname={pathname} />
    </div>
  </body>
</html>
