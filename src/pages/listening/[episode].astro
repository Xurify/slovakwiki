---
import SiteLayout from "@/layouts/SiteLayout.astro";
import EpisodePlayer from "$lib/components/listening/EpisodePlayer.svelte";
import ListeningEpisodePage from "$lib/components/listening/ListeningEpisodePage.svelte";
import { contentCacheKey } from "$lib/build/cache-key";
import { listeningEpisodes } from "$lib/catalog/listening";
import { episodeAudioSrcs } from "$lib/catalog/listening/audio";
import { lessonById, lessonPath } from "$lib/catalog/lessons";
import { practiceSetById } from "$lib/catalog/practice";
import { episodeStages } from "$lib/stick-figure/scene-sources";

export function getStaticPaths() {
  return listeningEpisodes.map((episode) => {
    const lesson = episode.lessonId ? lessonById.get(episode.lessonId) : undefined;
    const practiceSet = episode.practiceSetId
      ? practiceSetById.get(episode.practiceSetId)
      : undefined;

    const next = {
      grammarHref: episode.grammarSlug ? `/grammar/${episode.grammarSlug}` : undefined,
      lessonHref: lesson ? lessonPath(lesson) : undefined,
      practiceHref: practiceSet ? `/practice/${practiceSet.id}` : undefined,
    };

    const props = {
      episode,
      audio: episodeAudioSrcs(episode),
      next,
      stages: episodeStages(episode),
    };

    return {
      params: { episode: episode.slug },
      props,
      cacheKey: contentCacheKey(props),
    };
  });
}

const { episode, audio, next, stages } = Astro.props;
---

<SiteLayout
  title={`${episode.titleSk}${episode.topic ? ` (${episode.topic})` : ""} | Slovak Wiki Listening`}
  description={episode.promise}
  canonicalPath={`/listening/${episode.slug}`}
  stage
>
  <ListeningEpisodePage data={{ episode }}>
    <EpisodePlayer
      slot="player"
      client:load
      {episode}
      audioSrcs={audio}
      {next}
      {stages}
    />
  </ListeningEpisodePage>
</SiteLayout>
