---
import SiteLayout from "@/layouts/SiteLayout.astro";
import DictionaryDetailPage from "$lib/pages/DictionaryDetailPage.svelte";
import {
  normalizeAudioText,
  resolveAudioSrc,
} from "$lib/content/audio";
import { entryBySlug, words } from "$lib/content/data";

const lemmaTexts = new Set(
  words
    .filter((entry) => entry.kind === "word")
    .map((entry) => normalizeAudioText(entry.slovak))
    .filter(Boolean),
);

export function getStaticPaths() {
  return words.map((entry) => {
    const relatedEntries = entry.related
      .map((slug) => entryBySlug.get(slug))
      .filter((related): related is NonNullable<typeof related> => related !== undefined)
      .map((related) => ({
        english: related.english,
        kind: related.kind,
        slug: related.slug,
        slovak: related.slovak,
      }));

    return {
      params: { slug: entry.slug },
      props: {
        entry,
        relatedEntries,
        lemmaAudioSrc: resolveAudioSrc(entry.slovak, "lemma"),
        exampleAudioSrcs: entry.examples.map((example) => {
          const text = normalizeAudioText(example.slovak);
          // Overlap with a headword → same clip lives under lemma/
          const kind = lemmaTexts.has(text) ? "lemma" : "example";
          return resolveAudioSrc(example.slovak, kind);
        }),
      },
    };
  });
}

const { entry, relatedEntries, lemmaAudioSrc, exampleAudioSrcs } = Astro.props;
---

<SiteLayout
  title={`${entry.slovak} — ${entry.english} | Slovak Wiki`}
  description={entry.summary}
>
  <DictionaryDetailPage
    client:load
    data={{ entry, relatedEntries, lemmaAudioSrc, exampleAudioSrcs }}
  />
</SiteLayout>
