---
import { existsSync } from "node:fs";
import path from "node:path";

import SiteLayout from "@/layouts/SiteLayout.astro";
import type { AudioMountTarget } from "$lib/components/audio-mount";
import AudioMountHost from "$lib/components/AudioMountHost.svelte";
import DictionaryDetailPage from "$lib/pages/DictionaryDetailPage.svelte";
import { normalizeAudioText } from "$lib/content/audio";
import { resolveDictionaryAudioSrc } from "$lib/content/audio-resolve-server";
import { entryBySlug, words } from "$lib/content/data";
import { EXAMPLE_DISPLAY_LIMIT } from "$lib/content/example-limits";
import {
  getImageManifestEntry,
  imagesUseCdn,
  resolveImageSrc,
} from "$lib/content/images";
import {
  canonicalWordSlug,
  entryHref,
  lemmaSenseGroup,
  relatedSlugsForLemmaPage,
} from "$lib/content/lemma-senses";
import { contentCacheKey } from "$lib/build/cache-key";
import type { ContentEntry } from "$lib/content/types";

type DictionaryPageProps = {
  entry: ContentEntry;
  exampleAudioSrcs: string[];
  image:
    | {
        artist?: string;
        caption: string;
        license?: string;
        licenseUrl?: string;
        sourcePageUrl?: string;
        src: string;
      }
    | undefined;
  lemmaAudioSrc: string;
  relatedEntries: Array<{
    english: string;
    href: string;
    kind: ContentEntry["kind"];
    slug: string;
    slovak: string;
  }>;
  senses: Array<{
    entry: ContentEntry;
    exampleAudioSrcs: string[];
  }>;
};

export function getStaticPaths() {
  const lemmaTexts = new Set(
    words
      .filter((entry) => entry.kind === "word")
      .map((entry) => normalizeAudioText(entry.slovak))
      .filter(Boolean),
  );

  function exampleAudioSrcsFor(entry: (typeof words)[number]) {
    return entry.examples.map((example) => {
      const text = normalizeAudioText(example.slovak);
      const kind = lemmaTexts.has(text) ? "lemma" : "example";
      return resolveDictionaryAudioSrc(example.slovak, kind);
    });
  }

  function resolveLemmaImage(slug: string, fallbackCaption: string) {
    const imageEntry = getImageManifestEntry(slug);
    if (!imageEntry || imageEntry.status !== "ok" || !imageEntry.file) return undefined;

    // Local/dev: require file on disk. Prod CDN: trust manifest (files on R2).
    if (!imagesUseCdn()) {
      const diskPath = path.join(
        process.cwd(),
        "static",
        "images",
        "dictionary",
        imageEntry.file,
      );
      if (!existsSync(diskPath)) return undefined;
    }

    return {
      artist: imageEntry.artist,
      caption: imageEntry.caption?.trim() || fallbackCaption,
      license: imageEntry.license,
      licenseUrl: imageEntry.licenseUrl,
      sourcePageUrl: imageEntry.sourcePageUrl,
      src: resolveImageSrc(imageEntry.file),
    };
  }

  return words.flatMap((entry) => {
    const senses = lemmaSenseGroup(entry, words);
    const canonicalSlug = canonicalWordSlug(entry, words);

    if (entry.slug !== canonicalSlug) return [];

    const relatedEntries = relatedSlugsForLemmaPage(senses)
      .map((slug) => entryBySlug.get(slug))
      .filter((related): related is NonNullable<typeof related> => related !== undefined)
      .map((related) => ({
        english: related.english,
        href: entryHref(related, words),
        kind: related.kind,
        slug: related.slug,
        slovak: related.slovak,
      }));

    const titleEnglish = senses.map((sense) => sense.english).join(" · ");

    const props = {
      entry,
      senses: senses.map((sense) => ({
        entry: sense,
        exampleAudioSrcs: exampleAudioSrcsFor(sense),
      })),
      relatedEntries,
      lemmaAudioSrc: resolveDictionaryAudioSrc(entry.slovak, "lemma"),
      exampleAudioSrcs: exampleAudioSrcsFor(entry),
      image: resolveLemmaImage(entry.slug, titleEnglish),
    } satisfies DictionaryPageProps;

    return [
      {
        params: { slug: entry.slug },
        props,
        cacheKey: contentCacheKey(props),
      },
    ];
  });
}

const { entry, relatedEntries, lemmaAudioSrc, exampleAudioSrcs, senses, image } =
  Astro.props as DictionaryPageProps;

const titleEnglish = senses.map((sense) => sense.entry.english).join(" · ");

const audioTargets: AudioMountTarget[] = [];

if (lemmaAudioSrc) {
  audioTargets.push({
    key: "lemma",
    props: {
      label: `Listen to ${entry.slovak}`,
      size: "lg",
      src: lemmaAudioSrc,
      text: entry.slovak,
      variant: "inverse",
    },
  });
}

for (const [senseIndex, sense] of senses.entries()) {
  for (const [exampleIndex, example] of sense.entry.examples
    .slice(0, EXAMPLE_DISPLAY_LIMIT)
    .entries()) {
    const src = sense.exampleAudioSrcs[exampleIndex];
    if (!src) continue;

    audioTargets.push({
      key: `s${senseIndex}-e${exampleIndex}`,
      props: {
        label: `Listen to example: ${example.slovak}`,
        size: "sm",
        src,
        text: example.slovak,
      },
    });
  }
}
---

<SiteLayout
  title={`${entry.slovak} — ${titleEnglish} | Slovak Wiki`}
  description={entry.summary}
>
  <DictionaryDetailPage
    data={{ entry, relatedEntries, lemmaAudioSrc, exampleAudioSrcs, senses, image }}
  >
    {
      audioTargets.length > 0 && (
        <AudioMountHost slot="audioMount" client:load targets={audioTargets} />
      )
    }
  </DictionaryDetailPage>
</SiteLayout>
