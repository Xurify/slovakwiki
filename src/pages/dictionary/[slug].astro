---
import SiteLayout from "@/layouts/SiteLayout.astro";
import type { AudioMountTarget } from "$lib/audio/mount";
import AudioMountHost from "$lib/audio/AudioMountHost.svelte";
import DictionaryDetailPage from "$lib/components/dictionary/DictionaryDetailPage.svelte";
import {
  dictionaryPagePropsForSlug,
  dictionaryStaticPaths,
  type DictionaryPageProps,
} from "$lib/catalog/dictionary/detail-page";
import { EXAMPLE_DISPLAY_LIMIT } from "$lib/catalog/dictionary/example-limits";

export function getStaticPaths() {
  return dictionaryStaticPaths();
}

// Preview deployments render this route on demand (see astro.config.ts).
const pageProps = Astro.isPrerendered
  ? (Astro.props as DictionaryPageProps)
  : dictionaryPagePropsForSlug(Astro.params.slug ?? "");

if (!pageProps) {
  return new Response(null, { status: 404 });
}

const {
  entry,
  relatedEntries,
  lemmaAudioSrc,
  exampleAudioSrcs,
  entriesNear: nearbyEntries,
  frequencyNeighbors: frequencyRows,
  senses,
  image,
} = pageProps;

const titleEnglish = senses.map((sense) => sense.entry.english).join(" · ");

const audioTargets: AudioMountTarget[] = [];

if (lemmaAudioSrc) {
  audioTargets.push({
    key: "lemma",
    props: {
      label: `Listen to ${entry.slovak}`,
      size: "lg",
      src: lemmaAudioSrc,
      text: entry.slovak,
      variant: "inverse",
    },
  });
}

for (const [senseIndex, sense] of senses.entries()) {
  for (const [exampleIndex, example] of sense.entry.examples
    .slice(0, EXAMPLE_DISPLAY_LIMIT)
    .entries()) {
    const src = sense.exampleAudioSrcs[exampleIndex];
    if (!src) continue;

    audioTargets.push({
      key: `s${senseIndex}-e${exampleIndex}`,
      props: {
        label: `Listen to example: ${example.slovak}`,
        size: "sm",
        src,
        text: example.slovak,
      },
    });
  }
}
---

<SiteLayout
  title={`${entry.slovak} — ${titleEnglish} | Slovak Wiki`}
  description={entry.summary}
  canonicalPath={`/dictionary/${entry.slug}`}
>
  <DictionaryDetailPage
    data={{
      entry,
      relatedEntries,
      lemmaAudioSrc,
      exampleAudioSrcs,
      entriesNear: nearbyEntries,
      frequencyNeighbors: frequencyRows,
      senses,
      image,
    }}
  >
    {
      audioTargets.length > 0 && (
        <AudioMountHost slot="audioMount" client:load targets={audioTargets} />
      )
    }
  </DictionaryDetailPage>
</SiteLayout>
