---
import SiteLayout from "@/layouts/SiteLayout.astro";
import DictionaryCommonPage from "$lib/pages/DictionaryCommonPage.svelte";
import { words } from "$lib/content/data";
import { findLiveWordForLemma } from "$lib/content/frequency";
import { dictionaryHrefForSense } from "$lib/content/lemma-senses";
import { loadAllFrequencyLists } from "$lib/content/load-frequency";
import { FREQUENCY_POS_LABEL, type FrequencyPos } from "$lib/content/frequency-types";

export function getStaticPaths() {
  return (["verb", "noun", "adjective"] as const).map((pos) => ({
    params: { pos },
  }));
}

const pos = Astro.params.pos as FrequencyPos;
const allLists = await loadAllFrequencyLists();
const sourceList = allLists[pos];

const entries = sourceList.entries
  .filter((entry) => entry.lemma.trim().length > 1)
  .map((entry) => ({
    rank: entry.rank,
    lemma: entry.lemma,
    ...(entry.count !== undefined ? { count: entry.count } : {}),
  }));

const liveByLemma: Record<string, { english: string; slug: string; hash?: string }> = {};

for (const entry of entries) {
  const live = findLiveWordForLemma(entry.lemma, words, pos);
  if (!live) continue;
  const href = dictionaryHrefForSense(live, words);
  liveByLemma[entry.lemma] = {
    english: live.english,
    slug: href.slug,
    ...(href.hash ? { hash: href.hash } : {}),
  };
}

const tabs = (["verb", "noun", "adjective"] as const).map((value) => ({
  value,
  label: FREQUENCY_POS_LABEL[value],
  href: `/dictionary/common/${value}`,
}));
---

<SiteLayout
  title={`Most common ${FREQUENCY_POS_LABEL[pos].toLowerCase()} — Slovak Wiki`}
  description={`The most common Slovak ${FREQUENCY_POS_LABEL[pos].toLowerCase()} from the Slovak National Corpus.`}
>
  <DictionaryCommonPage
    client:load
    {entries}
    {liveByLemma}
    {pos}
    {tabs}
    sourceUrl={sourceList.sourceUrl}
  />
</SiteLayout>
