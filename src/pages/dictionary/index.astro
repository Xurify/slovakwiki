---
import SiteLayout from "@/layouts/SiteLayout.astro";
import WikiPage from "$lib/pages/WikiPage.svelte";
import { words } from "$lib/content/data";

const entries = words.map((word) => ({
  category: word.category,
  english: word.english,
  frequencyRank: word.frequency?.rank,
  origin: word.origin,
  slug: word.slug,
  slovak: word.slovak,
}));
---

<SiteLayout
  title="Dictionary — Slovak Wiki"
  description="Look up Slovak words by letter, part of speech, or English meaning."
>
  <WikiPage client:load {entries} />
</SiteLayout>
