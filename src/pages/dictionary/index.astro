---
import SiteLayout from "@/layouts/SiteLayout.astro";
import WikiBrowseClient from "$lib/components/WikiBrowseClient.svelte";
import WikiPage from "$lib/pages/WikiPage.svelte";
import {
  buildWikiPageView,
  parseBrowseSearchParams,
} from "$lib/content/dictionary-browse";

export const prerender = false;

const initialBrowse = parseBrowseSearchParams(Astro.url.searchParams);
const initialData = buildWikiPageView(
  initialBrowse.topic,
  initialBrowse.letter,
  initialBrowse.page,
);
---

<link rel="preload" href="/dictionary/index.json" as="fetch" crossorigin />

<SiteLayout
  title="Dictionary — Slovak Wiki"
  description="Look up Slovak words by letter, part of speech, or English meaning."
>
  <WikiPage>
    <WikiBrowseClient client:load slot="browse" {initialData} {initialBrowse} />
  </WikiPage>
</SiteLayout>
