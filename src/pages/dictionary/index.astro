---
import SiteLayout from "@/layouts/SiteLayout.astro";
import DictionaryBrowseClient from "$lib/components/dictionary/DictionaryBrowseClient.svelte";
import DictionaryBrowsePage from "$lib/components/dictionary/DictionaryBrowsePage.svelte";
import {
  buildDictionaryBrowseView,
  parseBrowseSearchParams,
} from "$lib/catalog/dictionary/browse";
import { DICTIONARY_BROWSE_INDEX_URL } from "$lib/catalog/dictionary/browse-query";

export const prerender = false;

const initialBrowse = parseBrowseSearchParams(Astro.url.searchParams);
const initialData = buildDictionaryBrowseView(
  initialBrowse.topic,
  initialBrowse.letter,
  initialBrowse.page,
);
const hasBrowseParams = [...Astro.url.searchParams.keys()].length > 0;
---

<link rel="preload" href={DICTIONARY_BROWSE_INDEX_URL} as="fetch" crossorigin />

<SiteLayout
  title="Dictionary — Slovak Wiki"
  description="Look up Slovak words by letter, part of speech, or English meaning."
  canonicalPath="/dictionary"
  noindex={hasBrowseParams}
>
  <DictionaryBrowsePage>
    <DictionaryBrowseClient client:load slot="browse" {initialData} {initialBrowse} />
  </DictionaryBrowsePage>
</SiteLayout>
