---
import SiteLayout from "@/layouts/SiteLayout.astro";
import DictionaryCommonPage from "$lib/pages/DictionaryCommonPage.svelte";
import { words } from "$lib/content/data";
import { findLiveWordForLemma } from "$lib/content/frequency";
import { loadAllFrequencyLists } from "$lib/content/load-frequency";
import type { FrequencyPos } from "$lib/content/frequency-types";

const allLists = await loadAllFrequencyLists();

/** Compact rows — drop repeated source/sourceUrl/pos from each lemma. */
function compactList(entries: { rank: number; lemma: string; count?: number }[]) {
  return entries
    .filter((entry) => entry.lemma.trim().length > 1)
    .map((entry) => ({
      rank: entry.rank,
      lemma: entry.lemma,
      ...(entry.count !== undefined ? { count: entry.count } : {}),
    }));
}

const lists = {
  verb: compactList(allLists.verb.entries),
  noun: compactList(allLists.noun.entries),
  adjective: compactList(allLists.adjective.entries),
} satisfies Record<FrequencyPos, ReturnType<typeof compactList>>;

/** lemma → { english, slug } — href built in the component. */
const liveByLemma: Record<string, { english: string; slug: string }> = {};

for (const pos of Object.keys(lists) as FrequencyPos[]) {
  for (const entry of lists[pos]) {
    if (liveByLemma[entry.lemma]) continue;
    const live = findLiveWordForLemma(entry.lemma, words);
    if (!live) continue;
    liveByLemma[entry.lemma] = {
      english: live.english,
      slug: live.slug,
    };
  }
}

const sourceUrl = allLists.verb.sourceUrl;
---

<SiteLayout
  title="Most common words — Slovak Wiki"
  description="The most common Slovak verbs, nouns, and adjectives from the Slovak National Corpus."
>
  <DictionaryCommonPage
    client:load
    lists={lists}
    liveByLemma={liveByLemma}
    sourceUrl={sourceUrl}
  />
</SiteLayout>
