---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PracticeReferencePage from "$lib/pages/PracticeReferencePage.svelte";
import { practiceItems } from "$lib/content/practice";

export function getStaticPaths() {
  return practiceItems.map((item) => ({
    params: { item: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<SiteLayout
  title="Practice reference | Slovak Wiki"
  description="Work one Slovak form saved from the reference."
>
  <PracticeReferencePage data={{ item }} client:load />
</SiteLayout>
