---
import { practiceItemHref, practiceItems } from "$lib/content/practice";

export function getStaticPaths() {
  return practiceItems.map((item) => ({
    params: { item: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const target = practiceItemHref(item.id) ?? "/practice";

return Astro.redirect(target);
---
