---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PracticeSetPage from "$lib/pages/PracticeSetPage.svelte";
import { practiceSets } from "$lib/content/practice";

export function getStaticPaths() {
  return practiceSets.map((set) => ({
    params: { set: set.id },
    props: { set },
  }));
}

const { set } = Astro.props;
---

<SiteLayout
  title={`${set.title} practice | Slovak Wiki`}
  description={`Contextual Slovak practice for ${set.title}.`}
>
  <PracticeSetPage data={{ set }} client:load />
</SiteLayout>
