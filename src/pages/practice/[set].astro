---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PracticeSetPage from "$lib/components/practice/PracticeSetPage.svelte";
import { dictionaryHrefsForItems } from "$lib/catalog/dictionary/lemma-href";
import { clozeAudioSrcs } from "$lib/catalog/practice/audio";
import { contentCacheKey } from "$lib/build/cache-key";
import { practiceItemById, practiceSets } from "$lib/catalog/practice";

export function getStaticPaths() {
  return practiceSets.map((set) => {
    const items = set.itemIds
      .map((itemId) => practiceItemById.get(itemId))
      .filter((item): item is NonNullable<typeof item> => item !== undefined);

    const props = {
      set,
      clozeAudioSrcs: clozeAudioSrcs(items),
      dictionaryHrefs: dictionaryHrefsForItems(items),
    };

    return {
      params: { set: set.id },
      props,
      cacheKey: contentCacheKey(props),
    };
  });
}

const { set, clozeAudioSrcs: audioSrcs, dictionaryHrefs } = Astro.props;
const hasSessionParam = Astro.url.searchParams.has("at");
---

<SiteLayout
  title={`${set.title} practice | Slovak Wiki`}
  description={`Slovak practice for ${set.title}.`}
  canonicalPath={`/practice/${set.id}`}
  noindex={hasSessionParam}
>
  <PracticeSetPage
    data={{ set, clozeAudioSrcs: audioSrcs, dictionaryHrefs }}
    client:load
  />
</SiteLayout>
