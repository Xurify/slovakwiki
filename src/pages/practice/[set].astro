---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PracticeSetPage from "$lib/pages/PracticeSetPage.svelte";
import { clozeAudioSrcs } from "$lib/content/practice-audio";
import { contentCacheKey } from "$lib/build/cache-key";
import { practiceItemById, practiceSets } from "$lib/content/practice";

export function getStaticPaths() {
  return practiceSets.map((set) => {
    const items = set.itemIds
      .map((itemId) => practiceItemById.get(itemId))
      .filter((item): item is NonNullable<typeof item> => item !== undefined);

    const props = {
      set,
      clozeAudioSrcs: clozeAudioSrcs(items),
    };

    return {
      params: { set: set.id },
      props,
      cacheKey: contentCacheKey(props),
    };
  });
}

const { set, clozeAudioSrcs: audioSrcs } = Astro.props;
---

<SiteLayout
  title={`${set.title} practice | Slovak Wiki`}
  description={`Slovak practice for ${set.title}.`}
>
  <PracticeSetPage data={{ set, clozeAudioSrcs: audioSrcs }} client:load />
</SiteLayout>
