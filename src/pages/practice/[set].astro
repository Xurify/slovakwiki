---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ClockQ1Boot from "$lib/components/practice/ClockQ1Boot.svelte";
import PracticeClockBoot from "$lib/components/practice/PracticeClockBoot.astro";
import PracticeSetPage from "$lib/components/practice/PracticeSetPage.svelte";
import PageShell from "$lib/components/ui/PageShell.svelte";
import { dictionaryHrefsForItems } from "$lib/catalog/dictionary/lemma-href";
import { clozeAudioSrcs } from "$lib/catalog/practice/audio";
import { contentCacheKey } from "$lib/build/cache-key";
import { practiceItemById, practiceSets } from "$lib/catalog/practice";
import { practiceSessionContext } from "$lib/catalog/practice/hub";
import FoucGate from "$lib/fouc/FoucGate.astro";
import { PRACTICE_SET_FOUC, practiceSetEarlyReadyScript } from "$lib/practice/fouc";

export function getStaticPaths() {
  return practiceSets.map((set) => {
    const items = set.itemIds
      .map((itemId) => practiceItemById.get(itemId))
      .filter((item): item is NonNullable<typeof item> => item !== undefined);

    const props = {
      set,
      clozeAudioSrcs: clozeAudioSrcs(items),
      dictionaryHrefs: dictionaryHrefsForItems(items),
      sessionContext: practiceSessionContext(set),
    };

    return {
      params: { set: set.id },
      props,
      cacheKey: contentCacheKey(props),
    };
  });
}

const { set, clozeAudioSrcs: audioSrcs, dictionaryHrefs, sessionContext } = Astro.props;
const hasSessionParam = Astro.url.searchParams.has("at");
const isClockSet = set.sessionKind === "days-dates-time";
---

<SiteLayout
  title={`${set.title} practice | Slovak Wiki`}
  description={`Slovak practice for ${set.title}.`}
  canonicalPath={`/practice/${set.id}`}
  noindex={hasSessionParam}
>
  {
    isClockSet ? (
      <>
        <PracticeClockBoot stage="gate" />
        <main class="py-8 pb-16 max-[600px]:py-5">
          <PageShell class="max-w-[640px]">
            <div class="grid" data-practice-set-hydrate>
              <div class="relative z-10 col-start-1 row-start-1" data-clock-q1-layer>
                <ClockQ1Boot {set} {sessionContext} />
              </div>
              <div class="relative z-0 col-start-1 row-start-1 min-w-0">
                <PracticeSetPage
                  client:only="svelte"
                  data={{
                    set,
                    clozeAudioSrcs: audioSrcs,
                    dictionaryHrefs,
                    sessionContext,
                  }}
                  layout="embed"
                />
              </div>
            </div>
          </PageShell>
        </main>
        <PracticeClockBoot stage="script" />
      </>
    ) : (
      <>
        <FoucGate surface={PRACTICE_SET_FOUC} />
        <script is:inline set:html={practiceSetEarlyReadyScript()} />
        <PracticeSetPage
          client:load
          data={{ set, clozeAudioSrcs: audioSrcs, dictionaryHrefs, sessionContext }}
        />
      </>
    )
  }
</SiteLayout>
