---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PronunciationDetailPage from "$lib/pages/PronunciationDetailPage.svelte";
import { pronunciationEntries } from "$lib/content/data";
import { sentenceCase } from "$lib/content/search-ui";

export function getStaticPaths() {
  return pronunciationEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const pageTitle = sentenceCase(entry.english);
---

<SiteLayout
  title={`${pageTitle} | Slovak Wiki Pronunciation`}
  description={entry.summary}
>
  <PronunciationDetailPage data={{ entry }} />
</SiteLayout>
