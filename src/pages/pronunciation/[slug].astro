---
import SiteLayout from "@/layouts/SiteLayout.astro";
import PronunciationDetailPage from "$lib/pages/PronunciationDetailPage.svelte";
import { contentCacheKey } from "$lib/build/cache-key";
import { entryBySlug, pronunciationEntries, words } from "$lib/catalog/entries";
import { entryHref } from "$lib/catalog/dictionary/lemma-senses";
import { sentenceCase } from "$lib/catalog/search/ui";

export function getStaticPaths() {
  return pronunciationEntries.map((entry) => {
    const relatedEntries = entry.related
      .map((slug) => entryBySlug.get(slug))
      .filter((related): related is NonNullable<typeof related> => related !== undefined)
      .map((related) => ({
        english: related.english,
        href: entryHref(related, words),
        kind: related.kind,
        slug: related.slug,
        slovak: related.slovak,
      }));

    const props = { entry, relatedEntries };

    return {
      params: { slug: entry.slug },
      props,
      cacheKey: contentCacheKey(props),
    };
  });
}

const { entry, relatedEntries } = Astro.props;
const pageTitle = sentenceCase(entry.english);
---

<SiteLayout
  title={`${pageTitle} | Slovak Wiki Pronunciation`}
  description={entry.summary}
  canonicalPath={`/pronunciation/${entry.slug}`}
>
  <PronunciationDetailPage data={{ entry, relatedEntries }} />
</SiteLayout>
