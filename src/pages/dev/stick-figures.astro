---
import SiteLayout from "@/layouts/SiteLayout.astro";
import StickFigureLab, {
  type StickLabScene,
} from "$lib/components/stick-figure/StickFigureLab.svelte";
import { lessons } from "$lib/catalog/lessons";
import { sceneAudioSrcs, sceneMouthTracks } from "$lib/catalog/lessons/audio";
import { characterIdForSpeaker } from "$lib/catalog/lessons/character-ids";
import { dialogueSpeakerLabel } from "$lib/components/practice/dialogue-speaker";
import { storySettingForLesson } from "$lib/lesson-story/story-settings";

const scenes: StickLabScene[] = lessons
  .map((lesson) => {
    const srcs = sceneAudioSrcs(lesson.scene);
    const mouths = sceneMouthTracks(lesson.scene);

    return {
      id: lesson.id,
      setting: storySettingForLesson(lesson.id).art,
      title: lesson.title,
      lines: lesson.scene.map((line) => ({
        characterId: characterIdForSpeaker(line.speaker),
        english: line.english,
        gestures: line.gestures,
        id: line.id,
        mouth: mouths[line.id]?.m,
        slovak: line.slovak,
        speaker: line.speaker,
        src: srcs[line.id],
        to: line.to ? characterIdForSpeaker(line.to) : undefined,
        vowels: mouths[line.id]?.v,
      })),
    };
  })
  .filter((scene) => scene.lines.some((line) => dialogueSpeakerLabel(line.speaker)));
---

<SiteLayout title="Stick figures | Slovak Wiki" noindex>
  <StickFigureLab client:load {scenes} />
</SiteLayout>
