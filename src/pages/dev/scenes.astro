---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ScenePlayer, {
  type PlayerLine,
  type PlayerScene,
  type PlayerSceneGroup,
} from "$lib/components/stick-figure/ScenePlayer.svelte";
import { lessons } from "$lib/catalog/lessons";
import { sceneAudioSrcs, sceneMouthTracks } from "$lib/catalog/lessons/audio";
import {
  characterIdForSpeaker,
  isLearnerSpeaker,
  listedCharacters,
} from "$lib/catalog/lessons/character-ids";
import { episodePath, listeningEpisodes } from "$lib/catalog/listening";
import { dialogueSpeakerLabel } from "$lib/components/practice/dialogue-speaker";
import type { DialogueTurn } from "$lib/learning/types";
import { RAIN_AND_TRAM, WEATHER_TODAY } from "$lib/stick-figure/dev-scenes";
import {
  chapterSettingFor,
  sceneThingWords,
  stageSettingFor,
} from "$lib/stick-figure/lesson-stage";
import { dayTalks } from "$lib/stick-figure/scene-day";
import { stageName } from "$lib/stick-figure/stage-name";
import { walkTalk, type Said, type Talk } from "$lib/stick-figure/talk";

function playerLines(turns: DialogueTurn[]): PlayerLine[] {
  const srcs = sceneAudioSrcs(turns);
  const mouths = sceneMouthTracks(turns);

  return turns.map((line) => ({
    characterId: characterIdForSpeaker(line.speaker),
    english: line.english,
    gestures: line.gestures,
    id: line.id,
    learner: isLearnerSpeaker(line.speaker),
    marks: line.marks,
    mouth: mouths[line.id]?.m,
    onStage: dialogueSpeakerLabel(line.speaker) !== null,
    props: line.props,
    sayChoices: line.sayChoices,
    slovak: line.slovak,
    speaker: stageName(line.speaker),
    src: srcs[line.id],
    to: line.to ? characterIdForSpeaker(line.to) : undefined,
    vowels: mouths[line.id]?.v,
  }));
}

const groups: PlayerSceneGroup[] = [
  {
    label: "From the lessons",
    scenes: lessons
      .filter((lesson) => lesson.scene.some((line) => dialogueSpeakerLabel(line.speaker)))
      .map((lesson) => ({
        english: lesson.title,
        href: `/lessons/${lesson.id}`,
        hrefLabel: "Open the lesson",
        id: lesson.id,
        lines: playerLines(lesson.scene),
        name: lesson.scene[0]?.slovak ?? lesson.title,
        setting: stageSettingFor(lesson.id),
      })),
  },
  ...listeningEpisodes.map((episode) => ({
    label: "From the podcast",
    slovak: episode.titleSk,
    scenes: episode.chapters.map((chapter) => ({
      checks: chapter.checks,
      english: chapter.title,
      href: episodePath(episode),
      hrefLabel: "Open the episode",
      id: chapter.id,
      lines: playerLines(chapter.lines),
      name: chapter.titleSk,
      order: episode.speakers.map(characterIdForSpeaker),
      setting: chapterSettingFor(chapter.id),
    })),
  })),
];

groups.push({
  label: "Prototype",
  scenes: [
    {
      english: RAIN_AND_TRAM[0].english,
      id: "dev/rain-and-tram",
      lines: playerLines(RAIN_AND_TRAM),
      name: RAIN_AND_TRAM[0].slovak,
      setting: "street",
    },
    {
      english: WEATHER_TODAY[0].english,
      id: "dev/weather-today",
      lines: playerLines(WEATHER_TODAY),
      name: WEATHER_TODAY[0].slovak,
      setting: "default",
    },
  ],
});

const speakers = Object.fromEntries(
  listedCharacters().map((character) => [character.id, character.speakers[0] ?? ""]),
);

/** A talk of the day on the square as a scene that branches on what Alex says. */
function talkScene(talk: Talk<Said & { id: string }>): PlayerScene {
  const line = (said: Said & { id: string }, speaker: string): PlayerLine =>
    playerLines([{ ...said, speaker }])[0];
  // Alex stays on the square after every goodbye; it is the others who walk on.
  const alex = (said: Said & { id: string }): PlayerLine => ({
    ...line(said, speakers.alex),
    stays: true,
  });
  const nodes = talk.nodes.map((node) => ({
    id: node.id,
    says: node.says.map((said) => line(said, speakers[talk.who])),
    replies: node.replies?.map((reply) => ({
      line: alex(reply.line),
      miss: reply.miss && {
        ...reply.miss,
        answer: reply.miss.answer && line(reply.miss.answer, speakers[talk.who]),
      },
      next: reply.next,
    })),
  }));

  return {
    english: talk.topic,
    id: talk.id,
    intro: talk.intro,
    lines: walkTalk(nodes).lines,
    name: talk.name,
    setting: talk.setting,
    talk: { nodes, who: talk.who },
    time: talk.time,
  };
}

groups.push({
  label: "Games",
  slovak: "Deň na námestí",
  scenes: dayTalks().map(talkScene),
});

const thingWords = sceneThingWords();
---

<SiteLayout title="Scenes | Slovak Wiki" noindex>
  <ScenePlayer client:load {groups} {thingWords} />
</SiteLayout>
