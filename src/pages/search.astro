---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SearchBox from "$lib/components/search/SearchBox.svelte";
import SearchPage from "$lib/components/search/SearchPage.svelte";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const title = query ? `${query} — Search | Slovak Wiki` : "Search | Slovak Wiki";
---

<SiteLayout
  {title}
  description="Search Slovak Wiki in English or Slovak, with or without diacritics."
  canonicalPath="/search"
  noindex
>
  <SearchPage>
    <SearchBox
      slot="search"
      client:load
      id="search-page-input"
      size="hero"
      class="max-w-none"
      initialQuery={query}
      placeholder="ahoj, nominative, meet someone…"
    />
  </SearchPage>
</SiteLayout>
