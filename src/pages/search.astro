---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SearchPage from "$lib/pages/SearchPage.svelte";

export const prerender = false;

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const title = query ? `${query} — Search | Slovak Wiki` : "Search | Slovak Wiki";
---

<SiteLayout
  {title}
  description="Search Slovak Wiki in English or Slovak, with or without diacritics."
>
  <SearchPage {query} />
</SiteLayout>
