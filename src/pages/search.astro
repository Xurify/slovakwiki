---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { buildSearchTopics } from "$lib/catalog/search/topics";
import SearchPage from "$lib/search/SearchPage.svelte";
import SearchResultsPage from "$lib/search/SearchResultsPage.svelte";

const topics = buildSearchTopics();
---

<SiteLayout
  title="Search | Slovak Wiki"
  description="Search Slovak Wiki in English or Slovak, with or without diacritics."
  canonicalPath="/search"
  noindex
>
  <SearchPage>
    <SearchResultsPage slot="search" client:load {topics} />
  </SearchPage>
</SiteLayout>
