---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ClockDrill from "$lib/components/ClockDrill.svelte";
import GrammarDetailPage from "$lib/pages/GrammarDetailPage.svelte";
import { entryBySlug, grammarEntries } from "$lib/content/data";
import { sentenceCase } from "$lib/content/search-ui";

export function getStaticPaths() {
  return grammarEntries.map((entry) => {
    const relatedEntries = entry.related
      .map((slug) => entryBySlug.get(slug))
      .filter((related): related is NonNullable<typeof related> => related !== undefined)
      .map((related) => ({
        english: related.english,
        kind: related.kind,
        slug: related.slug,
        slovak: related.slovak,
      }));

    return {
      params: { slug: entry.slug },
      props: { entry, relatedEntries },
    };
  });
}

const { entry, relatedEntries } = Astro.props;
---

<SiteLayout
  title={`${sentenceCase(entry.english)} | Slovak Wiki Grammar`}
  description={entry.summary}
>
  <GrammarDetailPage data={{ entry, relatedEntries }}>
    {
      entry.slug === "telling-time" && (
        <ClockDrill slot="clockDrill" client:only="svelte" />
      )
    }
  </GrammarDetailPage>
</SiteLayout>
