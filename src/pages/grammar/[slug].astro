---
import SiteLayout from "@/layouts/SiteLayout.astro";
import type { AudioMountTarget } from "$lib/audio/mount";
import AudioMountHost from "$lib/audio/AudioMountHost.svelte";
import ClockDrill from "$lib/learning/time/ClockDrill.svelte";
import GrammarDetailPage from "$lib/components/reference/GrammarDetailPage.svelte";
import { contentCacheKey } from "$lib/build/cache-key";
import { audioHash } from "$lib/catalog/audio/core";
import { audioClipKind, hasAudioClip } from "$lib/catalog/audio/manifest";
import { resolveKeyedAudioSrc } from "$lib/catalog/audio/resolve-server";
import { entryBySlug, grammarEntries, words } from "$lib/catalog/entries";
import { entryHref } from "$lib/catalog/dictionary/lemma-senses";
import { sentenceCase } from "$lib/catalog/search/ui";
import type { Example, GrammarContrast } from "$lib/catalog/types";
import GrammarWeakSpots from "$lib/components/reference/GrammarWeakSpots.svelte";
import { practiceRulesForGrammarTopic } from "$lib/practice/grammar-practice-rules";

export function getStaticPaths() {
  return grammarEntries.map((entry) => {
    const relatedEntries = entry.related
      .map((slug) => entryBySlug.get(slug))
      .filter((related): related is NonNullable<typeof related> => related !== undefined)
      .map((related) => ({
        english: related.english,
        href: entryHref(related, words),
        kind: related.kind,
        slug: related.slug,
        slovak: related.slovak,
      }));

    const audioTarget = (slovak: string, key: string): AudioMountTarget[] => {
      const hash = audioHash(slovak);
      if (!hasAudioClip(hash)) return [];

      const kind = audioClipKind(hash) === "lemma" ? "lemma" : "example";
      return [
        {
          key,
          props: {
            label: `Listen: ${slovak}`,
            size: "xs" as const,
            src: resolveKeyedAudioSrc(slovak, kind),
            text: slovak,
          },
        },
      ];
    };

    const exampleTargets = (examples: Example[], prefix: string): AudioMountTarget[] =>
      examples.flatMap((example, index) =>
        audioTarget(example.slovak, `${prefix}-${index}`),
      );

    const frameTargets = (
      frames: GrammarContrast[],
      prefix: string,
    ): AudioMountTarget[] =>
      frames.flatMap((frame, frameIndex) =>
        frame.choices.flatMap((choice, choiceIndex) =>
          audioTarget(choice.slovak.text, `${prefix}-${frameIndex}-${choiceIndex}`),
        ),
      );

    const audioTargets: AudioMountTarget[] = [
      ...exampleTargets(entry.examples, "ex"),
      ...(entry.morePatterns ?? []).flatMap((pattern, index) =>
        exampleTargets(pattern.examples ?? [], `more-${index}-ex`),
      ),
      ...frameTargets(entry.contrasts?.frames ?? [], "contrast"),
      ...frameTargets(entry.contrasts?.more ?? [], "contrast-more"),
    ];

    const practiceRules = practiceRulesForGrammarTopic(entry.slug);
    const props = { entry, relatedEntries, audioTargets, practiceRules };

    return {
      params: { slug: entry.slug },
      props,
      cacheKey: contentCacheKey(props),
    };
  });
}

const { entry, relatedEntries, audioTargets, practiceRules } = Astro.props;
---

<SiteLayout
  title={`${sentenceCase(entry.english)} | Slovak Wiki Grammar`}
  description={entry.summary}
  canonicalPath={`/grammar/${entry.slug}`}
>
  <GrammarDetailPage
    data={{ entry, relatedEntries, audioKeys: audioTargets.map((target) => target.key) }}
  >
    {
      audioTargets.length > 0 && (
        <AudioMountHost slot="audioMount" client:load targets={audioTargets} />
      )
    }
    {
      practiceRules.length > 0 && (
        <GrammarWeakSpots slot="weakSpots" client:only="svelte" rules={practiceRules} />
      )
    }
    {
      entry.slug === "telling-time" && (
        <ClockDrill slot="clockDrill" client:only="svelte" />
      )
    }
  </GrammarDetailPage>
</SiteLayout>
