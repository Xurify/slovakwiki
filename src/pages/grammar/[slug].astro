---
import SiteLayout from "@/layouts/SiteLayout.astro";
import type { AudioMountTarget } from "$lib/audio/mount";
import AudioMountHost from "$lib/audio/AudioMountHost.svelte";
import ClockDrill from "$lib/learning/time/ClockDrill.svelte";
import GrammarDetailPage from "$lib/components/reference/GrammarDetailPage.svelte";
import { contentCacheKey } from "$lib/build/cache-key";
import { audioHash } from "$lib/catalog/audio/core";
import { audioClipKind, hasAudioClip } from "$lib/catalog/audio/manifest";
import { resolveKeyedAudioSrc } from "$lib/catalog/audio/resolve-server";
import { entryBySlug, grammarEntries, words } from "$lib/catalog/entries";
import { entryHref } from "$lib/catalog/dictionary/lemma-senses";
import { sentenceCase } from "$lib/catalog/search/ui";

export function getStaticPaths() {
  return grammarEntries.map((entry) => {
    const relatedEntries = entry.related
      .map((slug) => entryBySlug.get(slug))
      .filter((related): related is NonNullable<typeof related> => related !== undefined)
      .map((related) => ({
        english: related.english,
        href: entryHref(related, words),
        kind: related.kind,
        slug: related.slug,
        slovak: related.slovak,
      }));

    const audioTargets: AudioMountTarget[] = entry.examples.flatMap((example, index) => {
      const hash = audioHash(example.slovak);
      if (!hasAudioClip(hash)) return [];

      const kind = audioClipKind(hash) === "lemma" ? "lemma" : "example";
      return [
        {
          key: `ex-${index}`,
          props: {
            label: `Listen: ${example.slovak}`,
            size: "sm" as const,
            src: resolveKeyedAudioSrc(example.slovak, kind),
            text: example.slovak,
          },
        },
      ];
    });

    const props = { entry, relatedEntries, audioTargets };

    return {
      params: { slug: entry.slug },
      props,
      cacheKey: contentCacheKey(props),
    };
  });
}

const { entry, relatedEntries, audioTargets } = Astro.props;
---

<SiteLayout
  title={`${sentenceCase(entry.english)} | Slovak Wiki Grammar`}
  description={entry.summary}
  canonicalPath={`/grammar/${entry.slug}`}
>
  <GrammarDetailPage
    data={{ entry, relatedEntries, audioKeys: audioTargets.map((target) => target.key) }}
  >
    {
      audioTargets.length > 0 && (
        <AudioMountHost slot="audioMount" client:load targets={audioTargets} />
      )
    }
    {
      entry.slug === "telling-time" && (
        <ClockDrill slot="clockDrill" client:only="svelte" />
      )
    }
  </GrammarDetailPage>
</SiteLayout>
