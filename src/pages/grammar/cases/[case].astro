---
import SiteLayout from "@/layouts/SiteLayout.astro";
import GrammarCasePage from "$lib/components/reference/GrammarCasePage.svelte";
import { contentCacheKey } from "$lib/build/cache-key";
import { caseTopics } from "$lib/catalog/entries";

export function getStaticPaths() {
  return caseTopics.map((topic) => ({
    params: { case: topic.slug },
    props: { topic },
    cacheKey: contentCacheKey(topic),
  }));
}

const { topic } = Astro.props;
---

<SiteLayout
  title={`${topic.name} case | Slovak Wiki`}
  description={topic.summary}
  canonicalPath={`/grammar/cases/${topic.slug}`}
>
  <GrammarCasePage data={{ topic }} />
</SiteLayout>
