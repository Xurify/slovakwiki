---
import SiteLayout from "@/layouts/SiteLayout.astro";
import LessonsProgressBoot from "$lib/components/lessons/LessonsProgressBoot.astro";
import LessonsProgressClient from "$lib/components/lessons/LessonsProgressClient.svelte";
import LessonsIndexPage from "$lib/components/lessons/LessonsIndexPage.svelte";
import { buildLessonsBootPayload } from "$lib/lesson-progress/boot-payload";

const payload = buildLessonsBootPayload(null);
---

<SiteLayout
  title="Lessons | Slovak Wiki"
  description="Independent Slovak lessons for everyday language, grammar, and pronunciation."
>
  <LessonsProgressBoot {payload} stage="gate" />
  <LessonsIndexPage />
  <LessonsProgressBoot {payload} stage="script" />
  <LessonsProgressClient client:load payload={payload} />
</SiteLayout>
