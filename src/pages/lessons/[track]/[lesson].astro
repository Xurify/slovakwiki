---
import SiteLayout from "@/layouts/SiteLayout.astro";
import LessonRailPlayer from "$lib/components/lessons/LessonRailPlayer.svelte";
import LessonPage from "$lib/components/lessons/LessonPage.svelte";
import { lessonAudioSrcs } from "$lib/catalog/lessons/audio";
import { contentCacheKey } from "$lib/build/cache-key";
import { lessons } from "$lib/catalog/lessons";

export function getStaticPaths() {
  return lessons.map((lesson) => ({
    params: { lesson: lesson.slug, track: lesson.track },
    props: { lesson },
    cacheKey: contentCacheKey(lesson),
  }));
}

const { lesson } = Astro.props;
const audio = lessonAudioSrcs(lesson);
---

<SiteLayout
  title={`${lesson.title} | Slovak Wiki Lessons`}
  description={lesson.promise}
  canonicalPath={`/lessons/${lesson.track}/${lesson.slug}`}
>
  <LessonPage data={{ lesson }}>
    <LessonRailPlayer
      slot="player"
      client:load
      {lesson}
      keyPhraseAudioSrcs={audio.keyPhrases}
      sceneAudioSrcs={audio.scene}
    />
  </LessonPage>
</SiteLayout>
