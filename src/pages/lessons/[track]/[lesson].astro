---
import SiteLayout from "@/layouts/SiteLayout.astro";
import LessonRailPlayer from "$lib/components/lessons/LessonRailPlayer.svelte";
import LessonPage from "$lib/components/lessons/LessonPage.svelte";
import { lessonAudioSrcs } from "$lib/catalog/lessons/audio";
import { contentCacheKey } from "$lib/build/cache-key";
import { lessons } from "$lib/catalog/lessons";
import { episodePath, listeningEpisodes } from "$lib/catalog/listening";
import { lessonScene, placeThingWords } from "$lib/stick-figure/scene-sources";

export function getStaticPaths() {
  return lessons.map((lesson) => {
    // Audio URLs belong in the cache key: regenerating clips changes them without
    // touching lesson text, and incrementalBuild would otherwise keep stale HTML.
    const stage = lessonScene(lesson);
    const sameTopic = listeningEpisodes.find((episode) => episode.lessonId === lesson.id);
    const props = {
      lesson,
      audio: lessonAudioSrcs(lesson),
      stage,
      thingWords: stage ? placeThingWords(stage.setting) : {},
      episode: sameTopic
        ? { href: episodePath(sameTopic), title: sameTopic.titleSk }
        : undefined,
    };

    return {
      params: { lesson: lesson.slug, track: lesson.track },
      props,
      cacheKey: contentCacheKey(props),
    };
  });
}

const { lesson, audio, stage, thingWords, episode } = Astro.props;
---

<SiteLayout
  title={`${lesson.title} | Slovak Wiki Lessons`}
  description={lesson.promise}
  canonicalPath={`/lessons/${lesson.track}/${lesson.slug}`}
>
  <LessonPage data={{ lesson }}>
    <LessonRailPlayer
      slot="player"
      client:load
      {lesson}
      keyPhraseAudioSrcs={audio.keyPhrases}
      exerciseOptionAudioSrcs={audio.options}
      sceneAudioSrcs={audio.scene}
      {episode}
      {stage}
      {thingWords}
    />
  </LessonPage>
</SiteLayout>
