---
import SiteLayout from "@/layouts/SiteLayout.astro";
import type { AudioMountTarget } from "$lib/components/audio-mount";
import AudioMountHost from "$lib/components/AudioMountHost.svelte";
import LessonPracticeBlock from "$lib/components/lessons/LessonPracticeBlock.svelte";
import LessonPage from "$lib/pages/LessonPage.svelte";
import { lessonAudioSrcs } from "$lib/content/lesson-audio";
import { contentCacheKey } from "$lib/build/cache-key";
import { lessons } from "$lib/content/lessons";

export function getStaticPaths() {
  return lessons.map((lesson) => ({
    params: { lesson: lesson.slug, track: lesson.track },
    props: { lesson },
    cacheKey: contentCacheKey(lesson),
  }));
}

const { lesson } = Astro.props;
const audio = lessonAudioSrcs(lesson);

const audioTargets: AudioMountTarget[] = [];

for (const line of lesson.scene) {
  const src = audio.scene[line.id];
  if (!src) continue;
  audioTargets.push({
    key: `scene-${line.id}`,
    props: {
      label: `Listen: ${line.speaker}`,
      size: "sm",
      src,
      text: line.audio?.transcript ?? line.slovak,
    },
  });
}

for (const [index, phrase] of lesson.keyPhrases.entries()) {
  const src = audio.keyPhrases[phrase.slovak];
  if (!src) continue;
  const isLead = index === 0;
  audioTargets.push({
    key: `phrase-${index}`,
    props: {
      label: `Listen: ${phrase.slovak}`,
      size: isLead ? "md" : "sm",
      src,
      text: phrase.audio?.transcript ?? phrase.slovak,
      variant: isLead ? "inverse" : "default",
    },
  });
}
---

<SiteLayout title={`${lesson.title} | Slovak Wiki Lessons`} description={lesson.promise}>
  <LessonPage data={{ lesson }}>
    <LessonPracticeBlock
      slot="practice"
      client:load
      {lesson}
      sceneAudioSrcs={audio.scene}
    />
  </LessonPage>
  {audioTargets.length > 0 && <AudioMountHost client:load targets={audioTargets} />}
</SiteLayout>
