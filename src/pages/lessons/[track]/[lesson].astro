---
import SiteLayout from "@/layouts/SiteLayout.astro";
import type { AudioMountTarget } from "$lib/components/audio/mount";
import AudioMountHost from "$lib/components/audio/AudioMountHost.svelte";
import LessonRailPlayer from "$lib/components/lessons/LessonRailPlayer.svelte";
import LessonPage from "$lib/components/lessons/LessonPage.svelte";
import { lessonAudioSrcs } from "$lib/catalog/lessons/audio";
import { contentCacheKey } from "$lib/build/cache-key";
import { lessons } from "$lib/catalog/lessons";

export function getStaticPaths() {
  return lessons.map((lesson) => ({
    params: { lesson: lesson.slug, track: lesson.track },
    props: { lesson },
    cacheKey: contentCacheKey(lesson),
  }));
}

const { lesson } = Astro.props;
const audio = lessonAudioSrcs(lesson);

const audioTargets: AudioMountTarget[] = [];

for (const [index, phrase] of lesson.keyPhrases.entries()) {
  const src = audio.keyPhrases[phrase.slovak];
  if (!src) continue;
  const isLead = index === 0;
  audioTargets.push({
    key: `phrase-${index}`,
    props: {
      label: `Listen: ${phrase.slovak}`,
      size: isLead ? "md" : "sm",
      src,
      text: phrase.audio?.transcript ?? phrase.slovak,
      variant: isLead ? "inverse" : "default",
    },
  });
}
---

<SiteLayout
  title={`${lesson.title} | Slovak Wiki Lessons`}
  description={lesson.promise}
  canonicalPath={`/lessons/${lesson.track}/${lesson.slug}`}
>
  <LessonPage data={{ lesson }}>
    <LessonRailPlayer
      slot="player"
      client:load
      {lesson}
      keyPhraseAudioSrcs={audio.keyPhrases}
      sceneAudioSrcs={audio.scene}
    />
  </LessonPage>
  {audioTargets.length > 0 && <AudioMountHost client:load targets={audioTargets} />}
</SiteLayout>
