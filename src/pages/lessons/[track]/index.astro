---
import SiteLayout from "@/layouts/SiteLayout.astro";
import LessonsProgressBoot from "$lib/components/lessons/LessonsProgressBoot.astro";
import LessonsProgressClient from "$lib/components/lessons/LessonsProgressClient.svelte";
import LessonTrackPage from "$lib/components/lessons/LessonTrackPage.svelte";
import { contentCacheKey } from "$lib/build/cache-key";
import { lessonTracks, lessonsForTrack } from "$lib/catalog/lessons";
import { buildLessonsBootPayload } from "$lib/lesson-progress/boot-payload";

export function getStaticPaths() {
  return lessonTracks.map((track) => {
    const props = { track, lessons: lessonsForTrack(track.id) };

    return {
      params: { track: track.id },
      props,
      cacheKey: contentCacheKey(props),
    };
  });
}

const { track, lessons } = Astro.props;
const payload = buildLessonsBootPayload(track.id);
---

<SiteLayout
  title={`${track.title} lessons | Slovak Wiki`}
  description={track.description}
>
  <LessonsProgressBoot {payload} stage="gate" />
  <LessonTrackPage data={{ track, lessons }} />
  <LessonsProgressBoot {payload} stage="script" />
  <LessonsProgressClient client:load payload={payload} />
</SiteLayout>
