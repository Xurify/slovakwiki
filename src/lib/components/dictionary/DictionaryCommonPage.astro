---
import { chipClass } from "$lib/components/ui/system-ui";
import DictionaryCommonRow from "$lib/components/dictionary/DictionaryCommonRow.svelte";
import Lead from "$lib/components/ui/Lead.svelte";
import PageShell from "$lib/components/ui/PageShell.svelte";
import TextLink from "$lib/components/ui/TextLink.svelte";
import { dataPanelClass, dataPanelHeadClass } from "$lib/components/ui/data-list-ui";
import {
  FREQUENCY_PART_OF_SPEECH_LABEL,
  type FrequencyPartOfSpeech,
} from "$lib/catalog/frequency/types";

interface CompactFrequencyEntry {
  count?: number;
  lemma: string;
  rank: number;
}

interface LiveLink {
  english: string;
  hash?: string;
  slug: string;
}

interface Tab {
  href: string;
  label: string;
  value: FrequencyPartOfSpeech;
}

interface Props {
  initialEntries: CompactFrequencyEntry[];
  liveByLemma: Record<string, LiveLink>;
  partOfSpeech: FrequencyPartOfSpeech;
  sourceUrl: string;
  tabs: Tab[];
  totalCount: number;
}

const { initialEntries, liveByLemma, partOfSpeech, sourceUrl, tabs, totalCount } =
  Astro.props as Props;

const label = FREQUENCY_PART_OF_SPEECH_LABEL[partOfSpeech].toLowerCase();
---

<main class="py-12 pb-20 max-[600px]:py-8">
  <PageShell class="max-w-[880px]">
    <nav class="mb-6 flex flex-wrap gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
      <TextLink href="/dictionary">Dictionary</TextLink>
      <span aria-hidden="true">/</span>
      <TextLink href="/dictionary/common">Most common</TextLink>
      <span aria-hidden="true">/</span>
      <span class="capitalize">{label}</span>
    </nav>

    <header class="max-w-[640px]">
      <h1>Most common {label}</h1>
      <Lead>
        The {`${totalCount.toLocaleString("en")} ${label}`} that appear most often in the Slovak
        National Corpus, ranked by how many times they occur. Open a word for its meaning, examples
        and forms.
      </Lead>
    </header>

    <nav class="mt-8 flex flex-wrap gap-1.5" aria-label="Part of speech">
      {
        tabs.map((tab) => (
          <a
            class={chipClass(partOfSpeech === tab.value)}
            href={tab.href}
            aria-current={partOfSpeech === tab.value ? "page" : undefined}
          >
            {tab.label}
          </a>
        ))
      }
    </nav>

    <section class={`${dataPanelClass} mt-4`} aria-label={`Most common ${label}`}>
      <div class={dataPanelHeadClass}>
        <slot name="filter" />
      </div>

      <table class="w-full border-collapse text-left" id="common-results-table">
        <caption class="sr-only">
          Most common {label} in the Slovak National Corpus
        </caption>
        <thead>
          <tr class="border-b border-slate-200 text-sm text-slate-500">
            <th class="px-4 py-2 text-right font-normal sm:px-5" scope="col">#</th>
            <th class="px-2 py-2 font-normal" scope="col">Word</th>
            <th class="px-2 py-2 font-normal" scope="col">Meaning</th>
            <th
              class="px-4 py-2 text-right font-normal max-sm:hidden sm:px-5"
              scope="col"
            >
              In corpus
            </th>
          </tr>
        </thead>
        <tbody id="common-results">
          {
            initialEntries.map((entry) => (
              <DictionaryCommonRow entry={entry} live={liveByLemma[entry.lemma]} />
            ))
          }
          <tr id="common-results-append-anchor" hidden></tr>
        </tbody>
      </table>

      <slot name="listControls" />
    </section>

    <p class="mt-8 text-sm text-slate-500">
      Counts are lemma occurrences in the
      <a
        class="text-blue-800 no-underline hover:underline"
        href={sourceUrl}
        rel="noopener noreferrer"
        target="_blank"
      >
        Slovak National Corpus
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
      (prim-8.0-public-all). Full attribution on
      <TextLink href="/references">References</TextLink>.
    </p>
  </PageShell>
</main>
