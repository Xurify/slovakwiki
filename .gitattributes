# Keep working copies LF. Overrides core.autocrlf so Prettier --check stays green on Windows.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary

content/audio/manifest.json linguist-generated=true
content/audio/runtime-index.json linguist-generated=true
content/images/manifest.json linguist-generated=true
content/frequency/lemma-index.json linguist-generated=true
